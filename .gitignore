
# ==========================================
# LoveCode - Git Ignore
# ==========================================

# ---- Build outputs ----
/bin/
/dist/
/build/
/out/
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# ---- Go ----
/vendor/
*.prof
coverage.out
coverage.html
*.coverprofile

# ---- SQLite databases ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ---- Secrets and credentials ----
.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

secrets/
credentials/
private/

# ---- Local configuration ----
config.local.toml
config.local.yaml
config.local.yml
config.local.json

# Local overrides
*.local.toml
*.local.yaml
*.local.yml
*.local.json

# ---- Logs and runtime data ----
/logs/
/data/
/runtime/
/tmp/
*.log
*.pid

# ---- Archives and generated packages ----
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ---- Temporary files ----
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ---- Linux desktop ----
.Trash-*
.directory

# ---- IDEs and editors ----
.idea/
.vscode/
*.code-workspace

# ---- OS generated files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Test artifacts ----
test-results/
playwright-report/
test-output/

# ---- Profiling and debugging ----
*.prof
*.trace
core
core.*

# ---- Local AI / model files ----
models/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth

# ---- Generated documentation artifacts ----
/docs/generated/
/site/

# ---- Local environment overrides ----
.envrc.local
.direnv/
